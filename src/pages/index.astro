---
// importar el componente de astro para tener un layout base
// en el cua precentar la pagina web.
import Layout from "../layouts/welcome/layout.astro";
import Navegation from "../components/welcome/components/navegation.astro";
import Welcome from "../components/welcome/sections/welcome.astro";
import AboutMe from "../components/welcome/sections/aboutMe.astro";
import Projects from "../components/welcome/sections/projects.astro";
import Technologies from "../components/welcome/sections/technologies.astro";
import Contact from "../components/welcome/sections/contact.astro";
---

<Layout>
  <!--
    div q contiene el contenido preparado para el slot del componente Layout
  -->
  <div>
    <!--
    Navegacion de la pagin web
    -->
    <Navegation />
    <!--
      contenido principal de la pagina web
    -->
    <main>
      <Welcome />
      <AboutMe />
      
      <Projects />
            
      <Technologies />
      <Contact />
    </main>
  </div>
</Layout>
